{
  "mcpServers": {
    "goliath-optional": {
      "command": "py",
      "args": [
        "-3.12",
        "${workspaceFolder}\\server.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "MCP_WORKSPACE_ROOT": "${workspaceFolder}\\..\\..",
        "MCP_ALLOW_MUTATIONS": "0"
      }
    }
  }
}